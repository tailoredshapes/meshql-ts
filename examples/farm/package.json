{
    "name": "@farmql/farm-example",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "build": "tsc",
        "gen-manifest": "ts-node scripts/gen-manifest.ts",
        "test": "vitest --passWithNoTests --run --hookTimeout=300000",
        "test:bdd": "c8 --reporter=text --reporter=html --reporter=json-summary --reporter=lcov --all=false --exclude='cucumber.js' --exclude='test/**' cucumber-js",
        "perf": "performance/scripts/run-perf-tests.sh",
        "perf:check": "performance/scripts/wait-for-services.sh"
    },
    "dependencies": {
        "@pushcorn/hocon-parser": "^1.3.1",
        "@tailoredshapes/meshql-auth": "workspace:^",
        "@tailoredshapes/meshql-casbin_auth": "workspace:^",
        "@tailoredshapes/meshql-common": "workspace:^",
        "@tailoredshapes/meshql-jwt_auth": "workspace:^",
        "@tailoredshapes/meshql-mongo_repo": "workspace:^",
        "@tailoredshapes/meshql-server": "workspace:^",
        "axios": "^1.6.7",
        "express": "^4.21.2",
        "js-yaml": "^4.1.0"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^12.2.0",
        "@tailoredshapes/meshql-graphlette": "workspace:^",
        "@tailoredshapes/meshql-sqlite_repo": "workspace:^",
        "@types/chai": "^4.3.11",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^20.0.0",
        "c8": "^10.1.3",
        "casbin": "^5.36.0",
        "chai": "^4.3.10",
        "jsonwebtoken": "^9.0.2",
        "openapi-client-axios": "^7.5.5",
        "testcontainers": "^10.18.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.0.0",
        "vitest": "^3.0.5"
    }
}
